# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vendorbridge:vendorbridge@localhost:5432/vendorbridge

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-256-bit-random-secret
JWT_REFRESH_SECRET=replace-with-256-bit-random-refresh-secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ─── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# ─── Blockchain (Polygon Mumbai / Amoy) ────────────────────────────────────────
BLOCKCHAIN_RPC_URL=https://rpc-mumbai.maticvigil.com
BLOCKCHAIN_PRIVATE_KEY=replace-with-funded-wallet-private-key
CONTRACT_ADDRESS=replace-with-deployed-contract-address

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@vendorbridge.com

# ─── Client ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
